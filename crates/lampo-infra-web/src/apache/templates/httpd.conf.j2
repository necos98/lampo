{# Main Apache configuration. Generated by Lampo — never edit by hand.
   Context: `main` (apache::render::MainView). Every path is pre-validated and uses forward
   slashes; quoting happens here, except for the log arguments (piped commands, quoted by the
   renderer). #}
# Generated by Lampo. Do not edit: changes are overwritten.
Define SRVROOT "{{ main.server_root }}"
ServerRoot "${SRVROOT}"

# Vhost files to include. Lampo's validation wrapper defines it first to point `httpd -t` at
# the staged tree; otherwise it is the live tree.
<IfDefine !LAMPO_VHOSTS>
    Define LAMPO_VHOSTS "{{ main.vhosts_glob }}"
</IfDefine>

# Loopback only: development sites are never exposed to the network.
{% for listen in main.listen %}
Listen {{ listen }}
{% endfor %}

{% for module in main.modules %}
LoadModule {{ module.name }} "{{ module.path }}"
{% endfor %}

ServerName localhost
UseCanonicalName Off
HostnameLookups Off
ServerTokens Prod
ServerSignature Off
PidFile "{{ main.pid_file }}"
# Logs are written directly; Lampo moves one past 10 MiB to <name>.1 before each (re)start.
ErrorLog {{ main.error_log }}
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\" %D" lampo

# Windows: no AcceptEx (breaks with some firewalls/VPN clients); no sendfile/mmap so files
# edited on shares or by VMs are never served stale.
AcceptFilter http none
AcceptFilter https none
EnableSendfile Off
EnableMMAP Off
ThreadsPerChild {{ main.threads_per_child }}
MaxConnectionsPerChild 0
Timeout 300
KeepAlive On
KeepAliveTimeout 5
# Large uploads are allowed (FcgidMaxRequestLen is the effective limit for PHP).
LimitRequestBody 0

TypesConfig "${SRVROOT}/conf/mime.types"
AddType application/javascript .mjs
AddType application/wasm .wasm
DirectoryIndex index.php index.html index.htm
AccessFileName .htaccess

<Directory />
    Options FollowSymLinks
    AllowOverride None
    Require all denied
</Directory>

<Files ".ht*">
    Require all denied
</Files>

# The document root is often the project root: never serve version-control metadata, secrets
# (`.env*`), git files (`.gitignore`, the `.git` file of a worktree), logs, SQL dumps or
# backups. Case-insensitive because NTFS is; `/.well-known/` is not matched. These sections
# merge after every <Directory> and `.htaccess`, but before <Location> and <If>: each site's
# vhost repeats the denial in a final <If> that nothing merges after (vhost.conf.j2).
# Apache matches directories with `/` separators on Windows too.
<DirectoryMatch "(?i)/\.(git|svn|hg)(/|$)">
    Require all denied
</DirectoryMatch>

<FilesMatch "(?i)^\.(env|git)|\.(log|sql|bak)$">
    Require all denied
</FilesMatch>

# PHP through mod_fcgid: php-cgi.exe processes are spawned on the first request of a site and
# reaped when idle, so an idle Lampo costs almost no RAM.
FcgidMaxProcesses {{ main.fcgid.max_processes }}
FcgidMaxProcessesPerClass {{ main.fcgid.max_processes_per_class }}
FcgidMinProcessesPerClass {{ main.fcgid.min_processes_per_class }}
FcgidIdleTimeout {{ main.fcgid.idle_timeout_secs }}
FcgidIdleScanInterval {{ main.fcgid.idle_scan_interval_secs }}
FcgidProcessLifeTime {{ main.fcgid.process_lifetime_secs }}
FcgidMaxRequestsPerProcess {{ main.fcgid.max_requests_per_process }}
# Long Xdebug step-debugging sessions and slow scripts must not be cut off.
FcgidIOTimeout {{ main.fcgid.io_timeout_secs }}
FcgidBusyTimeout {{ main.fcgid.busy_timeout_secs }}
# Windows only: time to connect to a freshly spawned php-cgi (cold start + antivirus scan).
FcgidConnectTimeout {{ main.fcgid.connect_timeout_secs }}
FcgidMaxRequestLen {{ main.fcgid.max_request_len }}
FcgidMaxRequestInMem {{ main.fcgid.max_request_in_mem }}

# Catch-all for host names no site claims: the first, so default, vhost of every listened
# address. On a dedicated port it refuses foreign Host headers (DNS rebinding). Its name never
# resolves, so `localhost` and `127.0.0.1` stay free for the site of a dedicated port.
<VirtualHost {{ main.catch_all_addresses }}>
    ServerName {{ main.catch_all_name }}
    DocumentRoot "${SRVROOT}/htdocs"
    RewriteEngine On
    RewriteRule ^ - [R=404,L]
    ErrorDocument 404 "Lampo: no site is configured for this host name."
</VirtualHost>

IncludeOptional "${LAMPO_VHOSTS}"
