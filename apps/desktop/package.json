{
	"name": "desktop",
	"version": "0.3.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:mock": "vite dev --mode mock",
		"dev:mock-fresh": "vite dev --mode mock-fresh",
		"tauri": "tauri",
		"bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
		"bump": "node ../../scripts/bump-version.mjs",
		"test": "node --test \"../../scripts/*.test.mjs\" \"src/**/*.test.ts\" && vitest run"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.73.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.0",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-process": "~2.4.0",
		"@tauri-apps/plugin-updater": "~2.12.0"
	}
}
