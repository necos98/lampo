{# One site (project or worktree environment). Generated by Lampo — never edit by hand.
   Context: `vhost` (apache::render::VhostView). One <VirtualHost> per address group (shared
   name-based port and/or dedicated loopback port), all with the same body. A dedicated port
   also answers to `localhost` and `127.0.0.1`; any other Host falls to the httpd.conf
   catch-all. #}
# Generated by Lampo for site {{ vhost.site }}. Do not edit: changes are overwritten.
{% for notice in vhost.notices %}
# NOTE: {{ notice }}
{% endfor %}
{% for block in vhost.blocks %}

<VirtualHost {{ block.addresses }}>
    ServerName {{ block.server_name }}
{% for alias in block.aliases %}
    ServerAlias {{ alias }}
{% endfor %}
    DocumentRoot "{{ vhost.document_root }}"
    # Logs go through rotatelogs: a circular set of size-bounded files (error.log, error.log.1, …).
    ErrorLog {{ vhost.error_log }}
    CustomLog {{ vhost.access_log }} lampo

    # PHP ({{ vhost.php_label }}): this site's own php-cgi.exe and php.ini (PHPRC).
    FcgidWrapper {{ vhost.fcgid_wrapper }} .php
{% for env in vhost.env %}
    FcgidInitialEnv {{ env.name }} "{{ env.value }}"
{% endfor %}
{% if vhost.project_env %}
    # Environment variables of the project (getenv(), $_SERVER).
{% for env in vhost.project_env %}
    SetEnv {{ env.name }} {{ env.value }}
{% endfor %}
{% endif %}
    FcgidPassHeader Authorization
    <FilesMatch "\.php$">
        SetHandler fcgid-script
    </FilesMatch>

{# No directory listing by default: a site that wants it enables it in `.htaccess`. #}
    <Directory "{{ vhost.document_root }}">
        Options FollowSymLinks ExecCGI
        AllowOverride All
        Require all granted
    </Directory>
{% if vhost.custom_directives %}

    # --- Custom directives of the project (verbatim) ---
{{ vhost.custom_directives }}
    # --- End of custom directives ---
{% endif %}
</VirtualHost>
{% endfor %}
