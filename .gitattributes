# Text files are stored and checked out with LF on every platform, whatever core.autocrlf
# says: embedded templates (include_str!), snapshots and string-matching tests must not depend
# on the checkout. PowerShell, NSIS, TOML, JSON, Svelte, etc. all accept LF.
* text=auto eol=lf

# cmd.exe needs CRLF in batch files.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never touch.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
*.zip binary

# Byte-exact fixtures (BOM, ANSI bytes, CRLF vs LF) are excluded in
# crates/lampo-infra-web/.gitattributes (`fixtures/** -text`).
